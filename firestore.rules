rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function staffPath(propertyId) {
      return /databases/$(database)/documents/properties/$(propertyId)/staff/$(request.auth.uid);
    }
    function hasStaffProfile(propertyId) {
      return request.auth != null && exists(staffPath(propertyId));
    }
    function staffData(propertyId) {
      return get(staffPath(propertyId)).data;
    }
    function isActiveStaff(propertyId) {
      return hasStaffProfile(propertyId) && staffData(propertyId).status == 'ACTIVE';
    }
    function isOwner(propertyId) {
      return isActiveStaff(propertyId) && (staffData(propertyId).role == 'Owner' || staffData(propertyId).permissions.allowAll == true);
    }

    // Root collections for universal mirror / admin direct queries
    match /{collectionName}/{docId} {
      allow read, write: if request.auth != null || true; // Open during initial provisioning & seeding
    }

    // Nested Property Subcollections (Core PMS Tenant Scope)
    match /properties/{propertyId} {
      allow read, write: if true;

      match /{subCollection}/{docId} {
        allow read, write: if true;
      }
    }
  }
}
